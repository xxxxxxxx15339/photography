---
import BaseLayout from '../components/BaseLayout.astro';
import { galleries } from '../data/galleries';

const BASE = import.meta.env.BASE_URL || '/';
const basePath = BASE.endsWith('/') ? BASE : `${BASE}/`;

const allPhotos = galleries.flatMap((gallery) => gallery.photos);
---

<BaseLayout
  title="Yasser Baouzil Photography"
  description="Editorial, minimal photography portfolio featuring selected galleries by Yasser Baouzil."
>
  <section class="home-hero">
    {allPhotos.map((photo, i) => (
      <img
        src={photo.thumb || photo.src}
        alt=""
        class={`bg-photo${i === 0 ? ' is-active' : ''}`}
        loading={i === 0 ? 'eager' : 'lazy'}
        decoding="async"
      />
    ))}
    <div class="home-hero-overlay"></div>
    <div class="home-actions">
      <a href={`${basePath}galleries/canon/`} class="home-btn">Canon</a>
      <a href={`${basePath}galleries/sony/`} class="home-btn">Sony</a>
    </div>
  </section>

  <script>
    (function () {
      const photos = document.querySelectorAll('.bg-photo');
      if (photos.length < 2) return;
      let idx = 0;
      setInterval(() => {
        photos[idx].classList.remove('is-active');
        idx = (idx + 1) % photos.length;
        photos[idx].classList.add('is-active');
      }, 4000);
    })();
  </script>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    width: 100%;
    height: 70vh;
    min-height: 24rem;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bg-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.6s ease;
  }

  .bg-photo.is-active {
    opacity: 1;
  }

  .home-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 12, 13, 0.35), rgba(10, 12, 13, 0.55));
  }

  .home-actions {
    position: relative;
    z-index: 1;
    display: flex;
    gap: var(--space-3);
  }

  .home-btn {
    padding: 0.9rem 2.4rem;
    border: 1px solid #fff;
    color: #fff;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: rgba(255, 255, 255, 0.06);
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .home-btn:hover,
  .home-btn:focus-visible {
    background: var(--accent);
    border-color: var(--accent);
  }
</style>
